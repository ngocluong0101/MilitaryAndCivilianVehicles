# API (và demo Gradio tuỳ chọn) chạy ONNX Runtime trên CPU. Không cần GPU/torch/ultralytics.
#   docker build -f docker/Dockerfile.cpu -t vehicledet:cpu .
#   docker run --rm -p 8000:8000 -v "$PWD/models:/models:ro" vehicledet:cpu
FROM python:3.12-slim

ARG WITH_DEMO=true
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY docker/requirements-serve.txt docker/requirements-demo.txt /tmp/
RUN pip install -r /tmp/requirements-serve.txt \
    && if [ "$WITH_DEMO" = "true" ]; then pip install -r /tmp/requirements-demo.txt; fi

# Cài package (chỉ cần mã nguồn; phụ thuộc đã cài ở trên). pyproject đọc requirements.txt nên phải copy.
COPY pyproject.toml requirements.txt ./
COPY src ./src
RUN pip install --no-deps .

RUN useradd --create-home --uid 1000 app && mkdir -p /models && chown app /models
USER app

# Mount thư mục chứa model vào /models (vd: -v ./models:/models:ro)
ENV MODEL_PATH=/models/best.onnx BACKEND=onnx DEVICE=cpu MAX_UPLOAD_MB=10
EXPOSE 8000 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["uvicorn", "vehicledet.serve.app:app", "--host", "0.0.0.0", "--port", "8000"]
